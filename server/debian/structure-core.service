[Unit]
Description=StructureCore C2 Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/structure-core/server
ExecStart=/usr/bin/node server.js
Restart=always
Environment=NODE_ENV=production
EnvironmentFile=/var/www/structure-core/server/.env

[Install]
WantedBy=multi-user.target
