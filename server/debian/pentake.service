[Unit]
Description=Pentake C2 Server
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/pentake/server
ExecStart=/usr/bin/node server.js
Restart=always
Environment=NODE_ENV=production
EnvironmentFile=/var/www/pentake/server/.env

[Install]
WantedBy=multi-user.target
