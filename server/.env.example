# Copy this file to server/.env and fill in real values.
# server/.env is gitignored and must never be committed.

# Admin registration code (also used to seed the default 'admin' account)
ADMIN_PASSWORD=change_me

# Shared API key used by compiled clients to authenticate exfiltration
API_KEY=change_me_too

# JWT signing secret (also XOR key for legacy /v2/data payloads)
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SECRET_KEY=change_me_as_well

# Server port
PORT=3000

# Optional comma-separated list of build IDs allowed to exfiltrate.
# When unset, any registered build in the database is allowed.
# ALLOWED_BUILD_IDS=user_1,user_2